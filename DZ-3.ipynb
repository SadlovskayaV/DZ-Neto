   "source": [
    "def middle(word):\n",
    "    n = len(word)\n",
    "    mid = n // 2\n",
    "    if n % 2 == 1:\n",
    "        return word[mid]\n",
    "    else:\n",
    "        return word[mid - 1:mid + 1]\n",
    "\n",
    "print(middle('test'))     # es\n",
    "print(middle('testing'))  # t"
   ]
  }
 ],
